# Supabase managed project
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace-me
# Server-only connection. Auth Web uses it indirectly to choose password vs OTP.

# Central identity UI, deployed separately at https://auth.aibibu.com.
# Only the public Supabase URL/key are compiled into auth-web. Never expose
# SUPABASE_SERVICE_ROLE_KEY to the frontend.
AUTH_WEB_URL=http://127.0.0.1:4174
AUTH_ALLOWED_REDIRECT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost:3002
AUTH_ALLOWED_FRAME_ANCESTORS="http://127.0.0.1:5173 http://localhost:5173 http://localhost:3002"

# Permanent commerce backend
SALEOR_API_URL=https://saleor.example.com/graphql/
SALEOR_CHANNEL=default-channel
SALEOR_APP_TOKEN=

# Billing, subscriptions, usage, and wallet
LAGO_API_URL=https://lago.example.com
LAGO_API_KEY=replace-me
LAGO_WEBHOOK_HMAC_SECRET=replace-me

# Saleor Wallet App -> Aibibu payment service authentication. Use the same
# random value as PAYMENT_INTERNAL_API_SECRET in saleor-app-payment-wallet.
PAYMENT_INTERNAL_API_SECRET=replace-with-at-least-32-random-characters
PAYMENT_OTP_TTL_SECONDS=300
PAYMENT_TOKEN_TTL_SECONDS=300
PAYMENT_OTP_RESEND_SECONDS=60
# Hosted Supabase production projects must configure custom SMTP and make the
# Magic Link/OTP email template include the six-digit {{ .Token }} value.

# Fulfillment webhook
N8N_WEBHOOK_SECRET=replace-me

# Managed profile distribution
BORROW_PRESIGN_TTL_SECONDS=300
BORROW_JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
BORROW_JWT_TTL_SECONDS=900

# Solfox RS256 entitlement signing. Keep the private JWK in deployment secrets.
SOLFOX_ENTITLEMENTS_JWT_SIGNING_KEY={"kty":"RSA","alg":"RS256","n":"...","e":"AQAB","d":"..."}
SOLFOX_ENTITLEMENTS_JWT_PUBLIC_KEY={"kty":"RSA","alg":"RS256","n":"...","e":"AQAB"}
SOLFOX_ENTITLEMENTS_JWT_ALGORITHM=RS256
SOLFOX_ENTITLEMENTS_JWT_TTL_SECONDS=3600

# Optional AI capture and new-api integration
AI_INGEST_HMAC_SECRET=replace-me
AI_RAW_BUCKET=ai-request-logs
AI_RETENTION_HOURS=24
AI_CAPTURE_CONSUMER_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
AI_REQUEST_LOG_KEY=request-log
NEWAPI_BASE_URL=
NEWAPI_ADMIN_TOKEN=

# Asynchronous Solfox moderation. Cloudflare Access credentials belong only
# on Aibibu Server; never put them in the desktop client configuration.
MODERATION_ENABLED=false
MODERATION_QUEUE_SIZE=1000
MODERATION_PII_URL=https://pii.linkflow.run
MODERATION_GUARD_URL=https://guard.linkflow.run
MODERATION_MODEL_TIMEOUT_SECONDS=15
MODEL_SERVICES_CF_ACCESS_CLIENT_ID=
MODEL_SERVICES_CF_ACCESS_CLIENT_SECRET=

AIBIBU_SERVER_HOST=127.0.0.1
AIBIBU_SERVER_PORT=12350
AIBIBU_SERVER_LOG_LEVEL=info
